# Copier ce fichier en .env (jamais commité) et adapter les valeurs.

# dev | test | prod
APP_ENV=dev

# PostgreSQL local (voir docker-compose.yml)
POSTGRES_USER=attrition
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=attrition
DATABASE_URL=postgresql+psycopg2://attrition:change-me-locally@localhost:5432/attrition

# Clés d'API autorisées, séparées par des virgules (>= 16 caractères en prod).
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=dev-key-change-me-0123456789

DECISION_THRESHOLD=0.5
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
